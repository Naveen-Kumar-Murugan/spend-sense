{
    "name": "spendsense-backend",
    "version": "1.0.0",
    "private": true,
    "description": "SpendSense backend - modular monolith running on AWS Lambda",
    "scripts": {
        "dev": "tsx watch src/dev-server.ts",
        "start": "tsx src/dev-server.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "seed": "tsx src/scripts/seed.ts",
        "lint": "eslint \"src/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "cdk": "cdk",
        "cdk:synth": "cdk synth",
        "cdk:deploy": "cdk deploy --all --require-approval never",
        "cdk:destroy": "cdk destroy --all --force"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.699.0",
        "@aws-sdk/client-dynamodb": "^3.699.0",
        "@aws-sdk/lib-dynamodb": "^3.699.0",
        "aws-jwt-verify": "^4.0.1",
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.145",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.20.4",
        "aws-cdk": "^2.167.0",
        "aws-cdk-lib": "^2.167.0",
        "constructs": "^10.4.2",
        "esbuild": "^0.24.0",
        "prettier": "^3.3.3",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^2.1.5"
    },
    "engines": {
        "node": ">=20"
    }
}
